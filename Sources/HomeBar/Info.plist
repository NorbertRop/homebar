<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>HomeBar</string>
  <key>CFBundleDisplayName</key><string>HomeBar</string>
  <key>CFBundleExecutable</key><string>HomeBar</string>
  <key>CFBundleIdentifier</key><string>bot.homebar.app</string>
  <key>CFBundleShortVersionString</key><string>0.1.2</string>
  <key>CFBundleVersion</key><string>3</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>LSUIElement</key><true/>
  <key>NSUserNotificationsUsageDescription</key><string>Notify when a sensor goes offline.</string>
  <!-- Sparkle auto-updates. Updates are verified with the EdDSA public key below
       (independent of Apple code signing); the private key lives in the maintainer's
       Keychain / CI secret. The feed must be publicly reachable — works once the repo
       is public (or appcast.xml is hosted somewhere Sparkle can GET it). -->
  <key>SUFeedURL</key><string>https://raw.githubusercontent.com/NorbertRop/homebar/main/appcast.xml</string>
  <key>SUPublicEDKey</key><string>eNbyK6iFySOb8ED2BCmc8JjVK+kLU1bp9Z/alURvvX0=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
  <!-- Home Assistant is typically self-hosted over plain http/ws on a LAN or VPN,
       so allow insecure loads. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key><true/>
  </dict>
</dict>
</plist>
